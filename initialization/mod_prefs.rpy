# Updates the navigation screen first to show "Mods"
init 200:
    screen navigation():

        vbox:
            style_prefix "navigation"

            xpos gui.navigation_xpos
            yalign 0.5

            spacing gui.navigation_spacing

            if main_menu:

                textbutton _("Start") action Start()

            else:

                textbutton _("History") action ShowMenu("history")

                textbutton _("Save") action  If(store.disable_saves, None, ShowMenu("save"))

            if not wholesome_mode:
                textbutton _("Load") action ShowMenu("load")

            # unused
            if False and not main_menu:
                if display_new_game_plus_option:
                    textbutton _("New Game+") action Confirm("New Game+ allows you to start a new game while retaining rewards from minigames. Any other progress will not be carried over. Are you sure you want to do this?", Jump("new_game_plus_label"))

            textbutton _("Preferences") action ShowMenu("preferences")

            # Show Mods button
            textbutton _("Mods") action ShowMenu("mods_preferences")

            if _in_replay:

                textbutton _("End Replay") action EndReplay(confirm=True)

            elif not main_menu:

                textbutton _("Main Menu") action MainMenu()

            textbutton _("About") action ShowMenu("about")

            if renpy.variant("pc"):

                ## Help isn't necessary or relevant to mobile devices.
                textbutton _("Help") action ShowMenu("help")

                ## The quit button is banned on iOS and unnecessary on Android.
                textbutton _("Quit") action Quit(confirm=not main_menu)

