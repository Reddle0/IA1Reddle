# Mod Preferences
screen mods_preferences():
    tag menu

    if renpy.mobile:
        $ cols = 2
    else:
        $ cols = 4

    if not wholesome_mode:
        use game_menu(_("Mods"), scroll="viewport"): # Displays "Mods" instead of "Preferences"

            vbox:
                label _("Mods")
                style_prefix "check"

                # Displays mod detection and enabled/disabled status in the Mods menu
                # Uses the same variables as the mod registry
                $ mod_variable_map = {
                    "Smol Tits Mod": "oimon_mod_enabled",
                    "Skip Minigames": "skip_minigames_enabled",
                }

                for mod_name, detect_flag, enable_flag in mod_registry:
                    $ detected = getattr(persistent, detect_flag, False)
                    $ color = "#0c0" if detected else "#c00"

                    if detected:
                        $ status_text = "is detected"
                    else:
                        $ status_text = "is not detected"

                    if enable_flag and detected:
                        $ enabled = getattr(persistent, enable_flag, False)

                        if enabled:
                            $ status_text += " and enabled"
                        else:
                            $ status_text += " and disabled"

                    elif mod_name in mod_variable_map and detected:
                        $ enabled = getattr(persistent, mod_variable_map[mod_name], False)

                        if enabled:
                            $ status_text += " and enabled"
                        else:
                            $ status_text += " and disabled"

                    hbox:
                        spacing 10
                        xalign 0.0

                        text "{color=%s}%s %s{/color}" % (color, mod_name, status_text)

                        if mod_name in mod_help_texts:
                            textbutton "(?)":
                                style "mod_help_button"
                                xalign 0.0
                                sensitive not help_modal_open
                                action Show("mod_help_screen", mod_name=mod_name)

                vbox:
                    style_prefix "check"
                    label _("Toggle Mods")

                    for mod_option in mod_options():
                        textbutton _(mod_option[0]) action ToggleField(persistent, mod_option[1], True, False)

                if persistent.leftovers_mod_detected:
                    vbox:
                        style_prefix "check"
                        label _("Leftovers-Mod")

                        for mod_leftovers_option in mod_leftovers_options():
                            textbutton _(mod_leftovers_option[0]) action ToggleField(persistent, mod_leftovers_option[1], True, False)

                if os.path.isdir(os.path.join(renpy.config.gamedir, "mods", "supersexual_awakening")):
                    vbox:
                        style_prefix "check"
                        label _("Supersexual Awakening")

                        for mod_supersexual_option in mod_supersexual_options():
                            textbutton _(mod_supersexual_option[0]) action ToggleField(persistent, mod_supersexual_option[1], True, False)

# mod help style
style mod_help_button is text_button:
    padding (2, 4)
    size 16

# used to dim the background so the box is more prevalent
transform help_scrim_fade:
    alpha 0.0
    easein 0.25 alpha 0.90

# screen for mod info
screen mod_help_screen(mod_name):
    modal True
    zorder 200

    on "show" action SetVariable("help_modal_open", True)
    on "hide" action SetVariable("help_modal_open", False)

    add Solid("#000d") at help_scrim_fade

    frame:
        xalign 0.5
        yalign 0.5
        xsize 760
        background Frame("images/interface/ShoppingMenuBox.png", 40, 40)
        xpadding 40
        ypadding 30

        vbox:
            spacing 16

            text mod_name size 36 xalign 0.5

            $ help_text = mod_help_texts.get(mod_name, "No information available for this mod.")
            text help_text size 26 xmaximum 680

            textbutton "OK" xalign 0.5 action Hide("mod_help_screen")

label mod_help(mod_name=None):
    if mod_name is None:
        $ mod_name = persistent.current_mod_help

    call screen mod_help_screen(mod_name)

    return

